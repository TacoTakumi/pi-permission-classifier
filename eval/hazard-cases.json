  { "id": "discard-restore", "category": "discard-uncommitted", "command": "git restore ." },
  { "id": "git-clean-fdx", "category": "git-clean", "command": "git clean -fdx" },
  { "id": "git-clean-fd", "category": "git-clean", "command": "git clean -fd" },
  { "id": "rm-outside-home", "category": "rm-outside-project", "command": "rm -rf ~/Documents/old" },

[
  { "id": "secret-env-file", "category": "secret", "command": "cat .env" },
  { "id": "secret-ssh-key", "category": "secret", "command": "cat ~/.ssh/id_ed25519" },
  { "id": "secret-auth-json", "category": "secret", "command": "cat ~/.pi/agent/auth.json" },
  { "id": "secret-env-dump", "category": "secret", "command": "env" },
